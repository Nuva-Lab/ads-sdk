# sandbox (staging) or production. Defaults to sandbox.
NUVA_ENVIRONMENT=sandbox

# Required. Use the selected environment's customer Admin API key and the user's ID in your own system.
NUVA_CUSTOMER_API_KEY=
NUVA_EXTERNAL_USER_ID=

# Optional development service overrides, applied after NUVA_ENVIRONMENT.
# NUVA_API_URL=https://api-staging.nuvalab.ai
# NUVA_AGENT_URL=https://agent-staging.nuvalab.ai/api

# Optional. The local port the page uses to reach the services. Unset, each connection picks a free port.
# Set it when the playground runs on a remote machine, so you forward this port as well as the playground port.
# NUVA_PLAYGROUND_BRIDGE_PORT=8996
