{
  "name": "ads-agent-playground",
  "version": "0.1.0-preview.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node start.mjs",
    "build": "pnpm --dir ../typescript build && node build.mjs",
    "typecheck": "pnpm --dir ../typescript build && tsc --noEmit",
    "test": "node --test tests/*.test.mjs && cd server && go test -race ./..."
  },
  "dependencies": {
    "@nuva/sdk": "workspace:*",
    "dompurify": "3.4.17",
    "esbuild": "0.25.12",
    "marked": "18.1.1"
  },
  "devDependencies": {
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "ws": "8.18.3"
  }
}
